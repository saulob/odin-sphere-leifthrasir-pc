# Pinned third-party sources (gpu/deps.txt, fetched by tools\build.ps1 with their commit in .osl_commit) and the
# project patches (gpu/patches/<name>/NNNN-name.patch) applied to a copy of them in the build tree.

set(OSL_PATCH_WORKFLOW_VERSION 1)
# Dependencies whose users build from OSL_SOURCE_DIR_<name>, so a patched copy reaches them.
set(OSL_PATCHABLE_SOURCES trg-launcher)
find_program(OSL_GIT_EXECUTABLE git)

# Patch files of patch_dir in application order; error is set for a misnamed file or a reused number.
function(osl_list_patches patch_dir out_files out_error)
    file(GLOB names LIST_DIRECTORIES true RELATIVE "${patch_dir}" "${patch_dir}/*")
    list(SORT names)
    set(files "")
    set(numbers "")
    set(error "")
    foreach(name IN LISTS names)
        if (NOT name MATCHES "^([0-9][0-9][0-9][0-9])-[a-z0-9]+(-[a-z0-9]+)*\\.patch$")
            set(error "${patch_dir}/${name}: patches are named NNNN-lowercase-words.patch")
            break()
        endif()
        set(number "${CMAKE_MATCH_1}")
        list(FIND numbers "${number}" other)
        if (NOT other EQUAL -1)
            list(GET files ${other} other)
            get_filename_component(other "${other}" NAME)
            set(error "${patch_dir}: ${other} and ${name} share the number ${number}")
            break()
        endif()
        list(APPEND numbers "${number}")
        list(APPEND files "${patch_dir}/${name}")
    endforeach()
    set(${out_files} "${files}" PARENT_SCOPE)
    set(${out_error} "${error}" PARENT_SCOPE)
endfunction()

# Hash of everything a patched copy is made from: the workflow, the pinned commit and each patch, in order.
function(osl_patch_fingerprint commit patch_files out_fingerprint)
    set(text "workflow ${OSL_PATCH_WORKFLOW_VERSION}\ncommit ${commit}\n")
    foreach(file IN LISTS patch_files)
        get_filename_component(name "${file}" NAME)
        file(SHA256 "${file}" hash)
        string(APPEND text "patch ${name} ${hash}\n")
    endforeach()
    string(SHA256 fingerprint "${text}")
    set(${out_fingerprint} "${fingerprint}" PARENT_SCOPE)
endfunction()

# Hash of the names and contents of the files under dir.
function(osl_tree_hash dir out_hash)
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${dir}" "${dir}/*")
    list(SORT files)
    set(text "")
    foreach(file IN LISTS files)
        file(SHA256 "${dir}/${file}" hash)
        string(APPEND text "${file} ${hash}\n")
    endforeach()
    string(SHA256 hash "${text}")
    set(${out_hash} "${hash}" PARENT_SCOPE)
endfunction()

# Why out_dir is not what stamp records it was made from (fingerprint), or empty when it is.
function(osl_patched_copy_problem out_dir stamp fingerprint out_problem)
    set(problem "")
    if (NOT EXISTS "${stamp}" OR NOT IS_DIRECTORY "${out_dir}")
        set(problem "no patched copy yet")
    else()
        file(READ "${stamp}" recorded)
        osl_tree_hash("${out_dir}" tree)
        if (NOT recorded MATCHES "^fingerprint ${fingerprint}\n")
            set(problem "the patches or the pinned commit changed")
        elseif (NOT recorded STREQUAL "fingerprint ${fingerprint}\ntree ${tree}\n")
            set(problem "the patched copy was modified")
        endif()
    endif()
    set(${out_problem} "${problem}" PARENT_SCOPE)
endfunction()

# Makes out_dir source_dir with patch_files applied. Only files whose content changes are written (with a new
# timestamp), so exactly the objects built from them rebuild; error is set when a patch does not apply.
function(osl_apply_patches source_dir patch_files out_dir out_error)
    set(${out_error} "" PARENT_SCOPE)
    if (NOT OSL_GIT_EXECUTABLE)
        set(${out_error} "git is needed to apply the patches to ${source_dir}" PARENT_SCOPE)
        return()
    endif()
    set(work "${out_dir}.work")
    file(REMOVE_RECURSE "${work}")
    file(COPY "${source_dir}/" DESTINATION "${work}" PATTERN ".git" EXCLUDE PATTERN ".osl_commit" EXCLUDE)
    # The ceiling keeps git apply from treating the copy as part of the repository around the build tree;
    # --ignore-whitespace matches a checkout with CRLF line endings (core.autocrlf).
    get_filename_component(ceiling "${work}" DIRECTORY)
    foreach(patch IN LISTS patch_files)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${ceiling}"
                        "${OSL_GIT_EXECUTABLE}" -C "${work}" apply --ignore-whitespace "${patch}"
                        RESULT_VARIABLE result ERROR_VARIABLE detail)
        if (NOT result EQUAL 0)
            string(STRIP "${detail}" detail)
            file(REMOVE_RECURSE "${work}")
            set(${out_error} "${patch} does not apply to ${source_dir}: ${detail}" PARENT_SCOPE)
            return()
        endif()
    endforeach()

    file(GLOB_RECURSE new_files LIST_DIRECTORIES false RELATIVE "${work}" "${work}/*")
    if (IS_DIRECTORY "${out_dir}")
        file(GLOB_RECURSE old_files LIST_DIRECTORIES false RELATIVE "${out_dir}" "${out_dir}/*")
        foreach(file IN LISTS old_files)
            if (NOT file IN_LIST new_files)
                file(REMOVE "${out_dir}/${file}")
            endif()
        endforeach()
    endif()
    foreach(file IN LISTS new_files)
        get_filename_component(dir "${out_dir}/${file}" DIRECTORY)
        file(MAKE_DIRECTORY "${dir}")
        file(COPY_FILE "${work}/${file}" "${out_dir}/${file}" ONLY_IF_DIFFERENT)
    endforeach()
    file(REMOVE_RECURSE "${work}")
endfunction()

# Sets out_dir to the patched copy of source_dir, refreshed when its patches, its commit or the copy changed.
function(osl_patched_source name source_dir commit patch_dir out_dir)
    osl_list_patches("${patch_dir}" patches error)
    if (error)
        message(FATAL_ERROR "${error}")
    endif()
    foreach(patch IN LISTS patches)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch}")
    endforeach()
    execute_process(COMMAND "${OSL_GIT_EXECUTABLE}" -C "${source_dir}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE changes RESULT_VARIABLE result)
    if (NOT result EQUAL 0 OR NOT changes STREQUAL "")
        message(FATAL_ERROR "${source_dir} is not the pristine pinned checkout (changes to it belong in ${patch_dir}): "
                            "delete it and run tools\\build.ps1 to fetch it again.")
    endif()

    set(copy "${CMAKE_BINARY_DIR}/patched/${name}")
    set(stamp "${copy}.stamp")
    list(LENGTH patches count)
    osl_patch_fingerprint("${commit}" "${patches}" fingerprint)
    osl_patched_copy_problem("${copy}" "${stamp}" "${fingerprint}" problem)
    if (problem)
        message(STATUS "Patched ${name}: applying ${count} patch(es) (${problem})")
        file(REMOVE "${stamp}")
        osl_apply_patches("${source_dir}" "${patches}" "${copy}" error)
        if (error)
            message(FATAL_ERROR "${error}")
        endif()
        osl_tree_hash("${copy}" tree)
        file(WRITE "${stamp}" "fingerprint ${fingerprint}\ntree ${tree}\n")
    else()
        message(STATUS "Patched ${name}: current (${count} patch(es))")
    endif()
    # An edit to the copy reconfigures, which restores it.
    file(GLOB_RECURSE copied LIST_DIRECTORIES false "${copy}/*")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${copied})
    set(${out_dir} "${copy}" PARENT_SCOPE)
endfunction()

# Checks that every gpu/deps.txt source is fetched at its pinned commit and sets OSL_SOURCE_DIR_<name> to the folder
# to build it from: the fetched one, or its patched copy when gpu/patches/<name> exists.
function(osl_pinned_sources)
    set(gpu "${PROJECT_SOURCE_DIR}/gpu")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${gpu}/deps.txt")
    # The globs reconfigure when a patch folder or a patch is added or removed; each patch is a dependency of its own.
    file(GLOB patch_dirs CONFIGURE_DEPENDS LIST_DIRECTORIES true RELATIVE "${gpu}/patches" "${gpu}/patches/*")
    file(GLOB patch_files CONFIGURE_DEPENDS "${gpu}/patches/*/*")
    foreach(patch_dir IN LISTS patch_dirs)
        if (NOT patch_dir IN_LIST OSL_PATCHABLE_SOURCES)
            message(FATAL_ERROR "gpu/patches/${patch_dir}: its users do not build from a patched copy "
                                "(OSL_PATCHABLE_SOURCES in cmake/OslPinnedSources.cmake).")
        endif()
    endforeach()

    file(STRINGS "${gpu}/deps.txt" lines)
    foreach(line IN LISTS lines)
        if (line MATCHES "^[ \t]*(#|$)")
            continue()
        endif()
        string(REGEX MATCHALL "[^ \t]+" fields "${line}")
        list(GET fields 0 path)
        list(GET fields 2 commit)
        get_filename_component(dir "${gpu}/${path}" ABSOLUTE)
        get_filename_component(name "${dir}" NAME)
        set(stamp "${dir}/.osl_commit")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${stamp}")
        set(fetched "")
        if (EXISTS "${stamp}")
            file(READ "${stamp}" fetched)
            string(STRIP "${fetched}" fetched)
        endif()
        if (NOT fetched STREQUAL commit)
            message(FATAL_ERROR "${dir} is missing or not the pristine checkout of the pinned commit ${commit} "
                                "(gpu/deps.txt): run tools\\build.ps1, which fetches it.")
        endif()
        if (name IN_LIST patch_dirs)
            osl_patched_source("${name}" "${dir}" "${commit}" "${gpu}/patches/${name}" dir)
        endif()
        set(OSL_SOURCE_DIR_${name} "${dir}" PARENT_SCOPE)
    endforeach()
endfunction()
