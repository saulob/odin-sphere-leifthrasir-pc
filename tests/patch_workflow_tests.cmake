# Patch workflow tests (tools\test.ps1): patch order and names, the fingerprint, the stamp check and the incremental
# patched copy of cmake/OslPinnedSources.cmake, on synthetic files in OSL_TEST_DIR.
# cmake -DOSL_TEST_DIR=<scratch folder> -P tests/patch_workflow_tests.cmake
cmake_minimum_required(VERSION 3.24)
include(${CMAKE_CURRENT_LIST_DIR}/../cmake/OslPinnedSources.cmake)
if (NOT OSL_TEST_DIR)
    message(FATAL_ERROR "OSL_TEST_DIR is required")
endif()

set(checks 0)
set(failures 0)
macro(check description condition)
    math(EXPR checks "${checks} + 1")
    cmake_language(EVAL CODE "if (NOT (${condition}))
math(EXPR failures \"\${failures} + 1\")
message(\"FAIL ${description}\")
endif()")
endmacro()

function(write_patch file target old new)
    file(WRITE "${file}" "diff --git a/${target} b/${target}\n--- a/${target}\n+++ b/${target}\n@@ -1 +1 @@\n-${old}\n+${new}\n")
endfunction()

set(root "${OSL_TEST_DIR}")
file(REMOVE_RECURSE "${root}")
set(patches "${root}/patches")
set(source "${root}/source")
file(MAKE_DIRECTORY "${patches}" "${source}/sub")
file(WRITE "${source}/a.txt" "alpha\n")
file(WRITE "${source}/sub/b.txt" "beta\n")

# Order and names.
write_patch("${patches}/0010-later.patch" a.txt alpha ALPHA)
write_patch("${patches}/0002-earlier.patch" sub/b.txt beta BETA)
osl_list_patches("${patches}" files error)
list(TRANSFORM files REPLACE ".*/" "")
check("patches sort by number" [[error STREQUAL "" AND files STREQUAL "0002-earlier.patch;0010-later.patch"]])

file(WRITE "${patches}/0002-again.patch" "")
osl_list_patches("${patches}" files error)
check("a reused number is rejected" [[error MATCHES "0002-again.patch and 0002-earlier.patch share the number 0002"]])
file(REMOVE "${patches}/0002-again.patch")

foreach(bad "fix.patch" "0003-Upper.patch" "003-short.patch" "0003-name.diff")
    file(WRITE "${patches}/${bad}" "")
    osl_list_patches("${patches}" files error)
    check("${bad} is rejected" [[error MATCHES "${bad}: patches are named"]])
    file(REMOVE "${patches}/${bad}")
endforeach()

# Fingerprint.
osl_list_patches("${patches}" files error)
osl_patch_fingerprint(1111 "${files}" base)
osl_patch_fingerprint(1111 "${files}" same)
check("the fingerprint is deterministic" [[base STREQUAL same]])
osl_patch_fingerprint(2222 "${files}" other)
check("the pinned commit changes the fingerprint" [[NOT base STREQUAL other]])
write_patch("${patches}/0010-later.patch" a.txt alpha Alpha)
osl_patch_fingerprint(1111 "${files}" other)
check("a patch edit changes the fingerprint" [[NOT base STREQUAL other]])
write_patch("${patches}/0010-later.patch" a.txt alpha ALPHA)
list(GET files 0 first)
osl_patch_fingerprint(1111 "${first}" other)
check("a removed patch changes the fingerprint" [[NOT base STREQUAL other]])
file(RENAME "${patches}/0010-later.patch" "${patches}/0011-later.patch")
osl_list_patches("${patches}" renamed error)
osl_patch_fingerprint(1111 "${renamed}" other)
check("a renamed patch changes the fingerprint" [[NOT base STREQUAL other]])
file(RENAME "${patches}/0011-later.patch" "${patches}/0010-later.patch")
set(OSL_PATCH_WORKFLOW_VERSION 0)
osl_patch_fingerprint(1111 "${files}" other)
check("the workflow version changes the fingerprint" [[NOT base STREQUAL other]])
set(OSL_PATCH_WORKFLOW_VERSION 1)

# Patched copy and stamp.
set(copy "${root}/copy")
set(stamp "${copy}.stamp")
osl_patched_copy_problem("${copy}" "${stamp}" "${base}" problem)
check("a missing copy is reported" [[problem STREQUAL "no patched copy yet"]])
osl_apply_patches("${source}" "${files}" "${copy}" error)
file(READ "${copy}/a.txt" a)
file(READ "${copy}/sub/b.txt" b)
check("both patches apply" [[error STREQUAL "" AND a STREQUAL "ALPHA\n" AND b STREQUAL "BETA\n"]])
file(READ "${source}/a.txt" a)
check("the source stays pristine" [[a STREQUAL "alpha\n"]])
osl_tree_hash("${copy}" tree)
file(WRITE "${stamp}" "fingerprint ${base}\ntree ${tree}\n")
osl_patched_copy_problem("${copy}" "${stamp}" "${base}" problem)
check("a recorded copy is current" [[problem STREQUAL ""]])
osl_patched_copy_problem("${copy}" "${stamp}" "${other}" problem)
check("other inputs make the copy stale" [[problem STREQUAL "the patches or the pinned commit changed"]])
file(APPEND "${copy}/a.txt" "edit\n")
osl_patched_copy_problem("${copy}" "${stamp}" "${base}" problem)
check("an edited copy is stale" [[problem STREQUAL "the patched copy was modified"]])

# Only files whose content changes are rewritten, including one going back to its pristine text.
osl_apply_patches("${source}" "${files}" "${copy}" error)
file(TIMESTAMP "${copy}/a.txt" a_before "%s")
file(TIMESTAMP "${copy}/sub/b.txt" b_before "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.2)
osl_apply_patches("${source}" "${files}" "${copy}" error)
file(TIMESTAMP "${copy}/a.txt" a_after "%s")
check("an unchanged file keeps its timestamp" [[a_before STREQUAL a_after]])
list(GET files 1 later)
file(WRITE "${copy}/stale.txt" "left over\n")
osl_apply_patches("${source}" "${later}" "${copy}" error)
file(READ "${copy}/sub/b.txt" b)
file(TIMESTAMP "${copy}/sub/b.txt" b_after "%s")
file(TIMESTAMP "${copy}/a.txt" a_after "%s")
check("an unpatched file returns to its source text" [[b STREQUAL "beta\n"]])
check("the reverted file gets a newer timestamp" [[b_after GREATER b_before]])
check("the still patched file keeps its timestamp" [[a_before STREQUAL a_after]])
check("a file no longer produced is removed" [[NOT EXISTS "${copy}/stale.txt"]])

write_patch("${patches}/0020-broken.patch" a.txt missing text)
osl_list_patches("${patches}" files error)
osl_apply_patches("${source}" "${files}" "${copy}" error)
check("a patch that does not apply names itself" [[error MATCHES "0020-broken.patch does not apply"]])

file(REMOVE_RECURSE "${root}")
message("${checks} checks, ${failures} failed")
if (failures)
    message(FATAL_ERROR "patch workflow tests failed")
endif()
